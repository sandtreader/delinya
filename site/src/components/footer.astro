---
const sections = [
  {
    title: "Product",
    links: [
      { label: "Open Delinya", href: "https://delinya.net" },
      { label: "Changelog", href: "/changelog" },
      { label: "GitHub", href: "https://github.com/sandtreader/delinya" },
    ],
  },
  {
    title: "Learn",
    links: [
      { label: "Docs", href: "/docs/" },
      { label: "Getting started", href: "/docs/getting-started/" },
      { label: "How-to guides", href: "/docs/howto/print-a-full-size-template/" },
      { label: "Keyboard shortcuts", href: "/docs/reference/keyboard-shortcuts/" },
    ],
  },
  {
    title: "About",
    links: [
      { label: "Paul Clark @sandtreader", href: "https://sandtreader.com" },
    ],
  },
];
---

<footer
  class="mt-24 border-t border-[var(--color-border-subtle)] bg-[var(--color-bg-surface)]">
  <div class="max-w-6xl mx-auto px-5 py-12 grid md:grid-cols-4 gap-8">
    <div>
      <div class="font-display font-semibold text-2xl text-[var(--color-text)]">
        Delinya
      </div>
      <p class="text-[var(--color-text-muted)] mt-3 text-sm leading-relaxed">
        2D drawing with real units.
      </p>
    </div>
    {
      sections.map((s) => (
        <div>
          <h4 class="font-display font-medium text-[var(--color-text)] text-sm uppercase tracking-wide">
            {s.title}
          </h4>
          <ul class="mt-3 flex flex-col gap-2">
            {s.links.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="text-[var(--color-text-muted)] hover:text-[var(--color-accent)] transition text-sm">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div
    class="border-t border-[var(--color-border-subtle)] py-5 text-center text-xs text-[var(--color-text-muted)]">
    © {new Date().getFullYear()} Paul Clark
  </div>
</footer>
