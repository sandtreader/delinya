---
interface Props {
  href: string;
  size?: "md" | "lg";
  block?: boolean;
  style?: "outline" | "primary" | "inverted" | "muted";
  class?: string;
  [x: string]: any;
}

const {
  href,
  block,
  size = "lg",
  style = "primary",
  class: className,
  ...rest
} = Astro.props;

const sizes = {
  lg: "px-5 py-2.5",
  md: "px-4 py-2",
};

const styles = {
  outline:
    "bg-transparent border-2 border-[var(--color-accent)] hover:bg-[var(--color-accent)]/10 text-[var(--color-accent)]",
  primary:
    "bg-[var(--color-accent)] text-white hover:bg-[var(--color-accent-dark)] border-2 border-transparent font-medium",
  inverted:
    "bg-[var(--color-text)] text-[var(--color-bg-deep)] border-2 border-transparent",
  muted:
    "bg-transparent hover:bg-[var(--color-bg-elevated)] text-[var(--color-text)] border-2 border-transparent",
};
---

<a
  href={href}
  {...rest}
  class:list={[
    "rounded-sm text-center transition focus-visible:ring-2 ring-offset-2 ring-[var(--color-accent)]/30",
    block && "w-full",
    sizes[size],
    styles[style],
    className,
  ]}
  ><slot />
</a>
