{
  "name": "delinya",
  "version": "0.3.0",
  "private": true,
  "description": "Browser-based 2D drawing tool with real units",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "relay": "PORT=2901 collab-relay",
    "publish:web": "pnpm build && rsync -avz --delete dist/ st1:/var/www/delinya.net/"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@sandtreader/collab": "^0.1.4",
    "bad-words": "^4.1.5",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^6.2.0",
    "vitest": "^4.1.5",
    "ws": "^8.22.0"
  }
}
